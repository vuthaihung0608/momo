# Copy this file to .env and fill in the optional keys below

# 1. Google Gemini API Key (Enables live Gemini 2.5 Flash Chat & Bill Photo Vision OCR)
# Free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Real Google OAuth 2.0 (Optional — when empty, MoneyLens AI uses instant local Google Account Sign-In)
# Create OAuth 2.0 Web Client at: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:8501
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501

# 3. Legal Real-Time Bank Auto-Sync Webhook Server (SePay / Casso / PayOS / Notification Forwarding)
WEBHOOK_PORT=8502
# When exposing via Cloudflare Tunnel / ngrok / your domain, set public HTTPS base URL here:
WEBHOOK_PUBLIC_URL=
